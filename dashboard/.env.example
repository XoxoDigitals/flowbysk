DATABASE_URL="postgresql://postgres:postgres@localhost:5432/google_flow_saas?schema=public"
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me"
# Required. Shared secret for internal service-to-service calls (web <-> python worker <-> flow-bib).
INTERNAL_API_SECRET="change-me"
# Required by the Python worker to encrypt Google session cookies at rest (AES-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DATA_ENCRYPTION_KEY="change-me-32-bytes-base64url"
# Comma-separated origins allowed to call the Python worker with credentials.
WORKER_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
PYTHON_WORKER_URL="http://127.0.0.1:8000"
BIB_WORKER_URL="http://127.0.0.1:8010"
BIB_PUBLIC_URL="https://flow.jkdigitalmy.shop/bib"
NEXT_PUBLIC_APP_URL="https://flow.jkdigitalmy.shop"
PUPPETEER_EXECUTABLE_PATH="/usr/bin/google-chrome-stable"
