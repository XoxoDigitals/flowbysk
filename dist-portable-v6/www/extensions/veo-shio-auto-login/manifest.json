{
  "manifest_version": 2,
  "name": "Flow Browser Auto Login",
  "version": "2.1.0",
  "description": "Google auto-login (email, password, TOTP) for Flow Browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Flow Browser Auto Login",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://accounts.google.com/*",
        "https://flow.google.com/*"
      ],
      "js": [
        "browser-guard.js",
        "automation.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
