<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617">

    <FrameLayout
        android:id="@+id/flowPane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <WebView
            android:id="@+id/flowView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF" />

        <LinearLayout
            android:id="@+id/authCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#07090e"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true"
                android:indeterminateTint="#38bdf8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Signing you in…"
                android:textColor="#f8fafc"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxWidth="320dp"
                android:text="Automatic Google login is running. Please wait."
                android:textColor="#94a3b8"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/captchaBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#0f172a"
            android:elevation="10dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:text="Please solve the captcha below — we will continue signing you in automatically"
            android:textColor="#fbbf24"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <WebView
        android:id="@+id/shellView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
