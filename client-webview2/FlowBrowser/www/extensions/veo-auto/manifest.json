{
  "author": {
    "email": "kylenguyenaws@gmail.com"
  },
  "name": "Flow Automation - Auto Flow on Google Flow",
  "description": "Auto Flow your prompts at scale. Batch generate and auto-download videos and images on Google Flow.",
  "version": "3.3.0.0",
  "version_name": "3.3.0",
  "manifest_version": 3,
  "action": {
    "default_title": "Flow Automation - Auto Flow on Google Flow"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-BEghIAIQ.js"
      ],
      "all_frames": false,
      "matches": [
        "*://flow.google.com/*"
      ],
      "run_at": "document_end"
    }
  ],
  "side_panel": {
    "default_path": "src/ui/side-panel/index.html"
  },
  "offline_enabled": true,
  "host_permissions": [
    "*://flow.google.com/*"
  ],
  "permissions": [
    "storage",
    "tabs",
    "background",
    "sidePanel",
    "activeTab",
    "downloads",
    "debugger",
    "cookies"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://flow.google.com/*"
      ],
      "resources": [
        "assets/catchUploadFile.ts-DJwIizxX.js",
        "assets/index.ts-BEghIAIQ.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "icons": {
    "16": "src/assets/logo.png",
    "24": "src/assets/logo.png",
    "32": "src/assets/logo.png",
    "128": "src/assets/logo.png"
  }
}
