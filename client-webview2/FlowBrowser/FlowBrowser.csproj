<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Flow Browser</AssemblyName>
    <RootNamespace>FlowBrowser</RootNamespace>
    <ApplicationTitle>Flow Browser</ApplicationTitle>
    <ApplicationIcon>FlowBrowser.ico</ApplicationIcon>
    <Version>2.0.28</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="FlowBrowser.ico" />
    <!-- Dev / folder-portable: copy www next to the binary -->
    <None Include="www\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="www" />
  </ItemGroup>

  <!-- Zip www and embed so a single-file publish needs no sibling www folder -->
  <Target Name="ZipWwwForEmbed" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_WwwZip>$(MSBuildProjectDirectory)\www.zip</_WwwZip>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -Command &quot;if (Test-Path '$(_WwwZip)') { Remove-Item '$(_WwwZip)' -Force }; Compress-Archive -Path '$(MSBuildProjectDirectory)\www\*' -DestinationPath '$(_WwwZip)' -Force&quot;" />
    <ItemGroup>
      <EmbeddedResource Include="$(_WwwZip)">
        <LogicalName>FlowBrowser.www.zip</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target Name="CleanWwwZip" AfterTargets="Clean">
    <Delete Files="$(MSBuildProjectDirectory)\www.zip" TreatErrorsAsWarnings="true" />
  </Target>

</Project>
