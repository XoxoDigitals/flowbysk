<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Flow Browser</AssemblyName>
    <RootNamespace>FlowBrowser</RootNamespace>
    <ApplicationTitle>Flow Browser</ApplicationTitle>
    <ApplicationIcon>FlowBrowser.ico</ApplicationIcon>
    <Version>6.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="FlowBrowser.ico" />
    <!-- Debug only: readable www next to binary. Release uses encrypted www.vault embed. -->
    <None Include="www\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="www" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <!--
    Release/publish: obfuscate JS → zip → AES-GCM www.vault embedded in EXE.
    Debug: encrypt plain www the same way (no loose plaintext in single-file).
  -->
  <Target Name="ZipWwwForEmbed" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_WwwZip>$(MSBuildProjectDirectory)\www.zip</_WwwZip>
      <_WwwVault>$(MSBuildProjectDirectory)\www.vault</_WwwVault>
      <_PackScript>$(MSBuildProjectDirectory)\tools\pack-www.ps1</_PackScript>
      <_EncryptScript>$(MSBuildProjectDirectory)\tools\encrypt-www.cjs</_EncryptScript>
    </PropertyGroup>
    <Exec Condition="'$(Configuration)' == 'Release'"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_PackScript)&quot;" />
    <Exec Condition="'$(Configuration)' != 'Release'"
          Command="powershell -NoProfile -Command &quot;if (Test-Path '$(_WwwZip)') { Remove-Item '$(_WwwZip)' -Force }; if (Test-Path '$(_WwwVault)') { Remove-Item '$(_WwwVault)' -Force }; Compress-Archive -Path '$(MSBuildProjectDirectory)\www\*' -DestinationPath '$(_WwwZip)' -Force; node '$(_EncryptScript)'&quot;" />
    <ItemGroup>
      <EmbeddedResource Include="$(_WwwVault)">
        <LogicalName>FlowBrowser.www.vault</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target Name="CleanWwwZip" AfterTargets="Clean">
    <Delete Files="$(MSBuildProjectDirectory)\www.zip;$(MSBuildProjectDirectory)\www.vault" TreatErrorsAsWarnings="true" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\www-packed" />
  </Target>

</Project>
