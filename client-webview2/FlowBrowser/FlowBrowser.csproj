<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Flow Browser</AssemblyName>
    <RootNamespace>FlowBrowser</RootNamespace>
    <ApplicationTitle>Flow Browser</ApplicationTitle>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <None Include="www\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="www" />
  </ItemGroup>

</Project>
