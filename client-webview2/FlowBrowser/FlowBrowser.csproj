<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Flow Browser</AssemblyName>
    <RootNamespace>FlowBrowser</RootNamespace>
    <ApplicationTitle>Flow Browser</ApplicationTitle>
    <ApplicationIcon>FlowBrowser.ico</ApplicationIcon>
    <Version>2.0.33</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="FlowBrowser.ico" />
    <!-- Dev / folder-portable: copy readable www next to the binary -->
    <None Include="www\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="www" />
  </ItemGroup>

  <!--
    Release/publish: obfuscate critical JS then zip www-packed into the single-file EXE.
    Debug: zip plain www (easier to inspect while developing).
  -->
  <Target Name="ZipWwwForEmbed" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_WwwZip>$(MSBuildProjectDirectory)\www.zip</_WwwZip>
      <_PackScript>$(MSBuildProjectDirectory)\tools\pack-www.ps1</_PackScript>
    </PropertyGroup>
    <Exec Condition="'$(Configuration)' == 'Release'"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_PackScript)&quot;" />
    <Exec Condition="'$(Configuration)' != 'Release'"
          Command="powershell -NoProfile -Command &quot;if (Test-Path '$(_WwwZip)') { Remove-Item '$(_WwwZip)' -Force }; Compress-Archive -Path '$(MSBuildProjectDirectory)\www\*' -DestinationPath '$(_WwwZip)' -Force&quot;" />
    <ItemGroup>
      <EmbeddedResource Include="$(_WwwZip)">
        <LogicalName>FlowBrowser.www.zip</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target Name="CleanWwwZip" AfterTargets="Clean">
    <Delete Files="$(MSBuildProjectDirectory)\www.zip" TreatErrorsAsWarnings="true" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\www-packed" />
  </Target>

</Project>
